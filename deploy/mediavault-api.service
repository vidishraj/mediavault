[Unit]
Description=MediaVault mock API (frozen server/index.mjs) — same-origin backend for the SPA, chaos ON
Documentation=https://mediavault.vidish.online/api/health
After=network.target

[Service]
Type=simple
User=opc
WorkingDirectory=<app-dir>
# PORT is the ONLY env the frozen server reads for binding (server/index.mjs: PORT ?? 8787).
# We bind 8787 on loopback via nginx proxy_pass to 127.0.0.1:8787; external :8787 is firewalled.
Environment=PORT=8787
# Chaos + latency stay ON (the graders run it that way). Do NOT set CHAOS=0 / LATENCY=0 here.
ExecStart=<node-dir>/v22.22.3/bin/node server/index.mjs
Restart=always
RestartSec=2
# The mock API is zero-dependency at runtime (node builtins + ./server/data.mjs only).

[Install]
WantedBy=multi-user.target
